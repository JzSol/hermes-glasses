# Copy to .env and adjust. The bridge reads these from the environment.

# Path to the hermes CLI (legacy text protocol only; realtime Adam uses the
# local Hermes HTTP/gateway APIs). Default: ~/.hermes/hermes-agent/.venv/bin/hermes
# HERMES_BIN=

# Force Hermes to use its normal global profile when this bridge is launched
# outside an interactive shell (for example by launchd).
# HERMES_HOME=~/.hermes

# Shared-secret auth. REQUIRED: the bridge refuses to start when this is
# blank. New clients send Authorization: Bearer <value> during the handshake.
# URL query-string credentials are rejected.
HERMES_BRIDGE_TOKEN=

# Bind the local process to loopback; expose it through a private Tailscale
# Serve listener when the phone needs to connect.
HERMES_BRIDGE_HOST=127.0.0.1
HERMES_BRIDGE_PORT=8765

# Set false for the Adam voice-only prototype. Visual queries then return a
# concise camera-disabled response without requesting a photo from the app.
HERMES_BRIDGE_VISION=false

# Session state is namespaced per bridge instance and kept owner-only.
# HERMES_BRIDGE_SESSION_FILE=~/.hermes_glasses_bridge_session.json

# Hermes execution context and safety bounds. The workdir defaults to the
# bridge process cwd; set it explicitly for launchd.
# HERMES_BRIDGE_WORKDIR=
HERMES_BRIDGE_MAX_TURNS=20
HERMES_BRIDGE_RUN_BUDGET=90

# Loopback Hermes web/API service used for final speech-to-text, the
# persistent agent session, and streaming Kokoro TTS. Adam prefers the
# optional MLX Whisper plugin on Apple silicon; it falls back to Hermes's
# faster-whisper backend when available. Configure the provider in Hermes's
# config.yaml after installing that plugin dependency.
HERMES_BRIDGE_API_BASE=http://127.0.0.1:9119

# If that fixed-port dashboard requires interactive password/OAuth login,
# Adam automatically starts a separate token-authenticated Hermes backend on
# a random loopback port. It is never exposed by Tailscale and exits with the
# bridge. Set false only when API_BASE already provides non-interactive auth.
HERMES_BRIDGE_PRIVATE_BACKEND=auto
# HERMES_BRIDGE_PRIVATE_PYTHON=~/.hermes/hermes-agent/.venv/bin/python
# Warm the private backend, configured local STT model, and Kokoro at launch
# instead of adding their cold-start time after the first "Adam" command.
HERMES_BRIDGE_PREWARM=true

# Maximum uploaded Adam utterance duration. The iPhone also caps recordings.
HERMES_BRIDGE_AUDIO_MAX_SECONDS=30

# Fast per-session Hermes profile for spoken turns. These values do not change
# the global Hermes model. If this profile cannot run, Adam retries once with
# the existing Hermes profile (including its OpenAI or Claude subscription).
HERMES_BRIDGE_AGENT_PROVIDER=openai-codex
HERMES_BRIDGE_AGENT_MODEL=gpt-5.4-mini
HERMES_BRIDGE_AGENT_REASONING_EFFORT=low
HERMES_BRIDGE_AGENT_FAST=true

# Which brain answers queries:
#   hermes (default) - the Hermes agent CLI (tools, agentic)
#   anthropic | openai | gemini - call that provider's API directly
#   NOTE: Direct-provider brains are single-turn only (no conversation memory;
#   use hermes brain for cross-turn conversation history and tool access)
HERMES_BRIDGE_BRAIN=hermes

# Model for the direct-provider brains (ignored for hermes)
# NOTE: Must match the selected brain's provider (e.g., Claude model id only
# works with anthropic or claude; OpenAI model id only works with openai)
HERMES_BRIDGE_MODEL=claude-opus-4-8

# Override the provider base URL (OpenAI-compatible proxies / Ollama)
# HERMES_BRIDGE_BASE_URL=

# Provider API keys (only the selected brain's key is needed)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Legacy text clients only: set to 1 for bridge-side Edge TTS. Adam protocol
# v2 always uses Hermes streaming TTS (Kokoro) with Edge as its failure or
# Latvian fallback.
HERMES_BRIDGE_TTS=
